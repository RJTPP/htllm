---
import '../styles/fonts.css';
import '../styles/global.css';
import { BASE_PATH } from '../lib/base-path';

interface Props {
  title: string;
}

const { title } = Astro.props;
// Base-aware asset paths, so the site also works when hosted under a path.
const base = BASE_PATH;
const description = 'Private AI chat in your browser. Run a model in the browser or on your own server; your chats and files stay on this device.';
const ogImage = Astro.site ? new URL(`${base}og-image.png`, Astro.site).href : `${base}og-image.png`;

// Production CSP hashes Astro hydration scripts at build time. The Vite dev server
// requires 'unsafe-inline'/'unsafe-eval' for HMR and the React refresh
// preamble, so the dev policy is relaxed for scripts and websockets only.
// connect-src allows any HTTPS host plus localhost so BYOK / localhost
// providers can reach user-configured endpoints. JavaScript eval is forbidden;
// WebAssembly compilation remains available for Shiki and WebLLM.
const connectSrc = "connect-src 'self' https: http://localhost:* http://127.0.0.1:*";
const prodCsp =
  `default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; ${connectSrc}; img-src 'self' data: blob:; worker-src 'self' blob:`;
const devCsp =
  `default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; ${connectSrc} ws:; img-src 'self' data: blob:; worker-src 'self' blob:`;
const csp = import.meta.env.DEV ? devCsp : prodCsp;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="Content-Security-Policy" content={csp} />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0a0a0a" />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="htllm" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>
