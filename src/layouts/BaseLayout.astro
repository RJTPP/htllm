---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Production CSP hashes Astro hydration scripts at build time. The Vite dev server
// requires 'unsafe-inline'/'unsafe-eval' for HMR and the React refresh
// preamble, so the dev policy is relaxed for scripts and websockets only.
// connect-src allows any HTTPS host plus localhost so BYOK / localhost
// providers can reach user-configured endpoints. JavaScript eval is forbidden;
// WebAssembly compilation remains available for Shiki and WebLLM.
const connectSrc = "connect-src 'self' https: http://localhost:* http://127.0.0.1:*";
const prodCsp =
  `default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; ${connectSrc}; img-src 'self' data: blob:; worker-src 'self' blob:`;
const devCsp =
  `default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; ${connectSrc} ws:; img-src 'self' data: blob:; worker-src 'self' blob:`;
const csp = import.meta.env.DEV ? devCsp : prodCsp;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="Content-Security-Policy" content={csp} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>
